# =============================
# 🔑 Environment Variables for LLM Engineering
# =============================
# Copy this file to .env in the same directory (.devcontainer/variables/.env)
# and fill in the values for the services you plan to use.
#
#   cp .devcontainer/variables/example.env .devcontainer/variables/.env
#
# Lines starting with # are comments. Uncomment and set the ones you need.
# At minimum, OPENAI_API_KEY is required for most exercises.
# =============================

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic ---
# ANTHROPIC_API_KEY=

# --- Google / Gemini ---
# GOOGLE_API_KEY=

# --- DeepSeek ---
# DEEPSEEK_API_KEY=

# --- Hugging Face ---
# HF_TOKEN=

# --- Groq ---
# GROQ_API_KEY=

# --- OpenRouter ---
# OPENROUTER_API_KEY=

# --- Weights & Biases ---
# WANDB_API_KEY=
